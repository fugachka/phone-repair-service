@model List<Fault>
@{ ViewData["Title"] = "Справочник неисправностей"; }
<h1>Справочник неисправностей</h1>
<p><a asp-action="Edit" asp-route-id="0">Добавить неисправность</a></p>
<table>
    <tr><th>Наименование</th><th>Базовая стоимость</th><th></th></tr>
    @foreach (var f in Model)
    {
        <tr>
            <td>@f.Title</td>
            <td>@Money.Format(f.BasePrice)</td>
            <td><a asp-action="Edit" asp-route-id="@f.Id">Изменить</a></td>
        </tr>
    }
</table>
