@model List<Order>
@{ ViewData["Title"] = "Мои заказы"; }
<h1>Мои заказы</h1>
@if (Model.Count == 0)
{
    <p class="warning">У вас нет активных или завершенных заказов</p>
}
else
{
    <table>
        <tr><th>№ заказа</th><th>Дата приёма</th><th>Модель</th><th>Статус</th><th></th></tr>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.Id</td>
                <td>@o.CreationDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@o.PhoneModel.GetFullName()</td>
                <td>@o.Status.ToDisplayName()</td>
                <td><a asp-action="Details" asp-route-id="@o.Id">Открыть карточку</a></td>
            </tr>
        }
    </table>
}
