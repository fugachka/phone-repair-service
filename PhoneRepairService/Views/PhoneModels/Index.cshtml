@model List<PhoneModel>
@{ ViewData["Title"] = "Справочник моделей телефонов"; }
<h1>Справочник моделей телефонов</h1>
<p><a asp-action="Edit" asp-route-id="0">Добавить модель</a></p>
<table>
    <tr><th>Бренд</th><th>Модель</th><th>Состояние</th><th></th></tr>
    @foreach (var m in Model)
    {
        <tr class="@(m.IsActive ? "" : "inactive")">
            <td>@m.Brand</td>
            <td>@m.ModelName</td>
            <td>@(m.IsActive ? "активна" : "деактивирована")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@m.Id">Изменить</a>
                @if (m.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@m.Id" method="post" style="display:inline">
                        <button type="submit">Деактивировать</button>
                    </form>
                }
            </td>
        </tr>
    }
</table>
