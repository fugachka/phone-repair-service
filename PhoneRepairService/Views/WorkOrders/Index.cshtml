@model List<Order>
@{ ViewData["Title"] = "Общий список заказов"; }
<h1>Общий список заказов</h1>
@if (Model.Count == 0)
{
    <p>Заказов пока нет.</p>
}
else
{
    <table>
        <tr><th>№</th><th>Дата приёма</th><th>Клиент</th><th>Модель</th><th>Неисправности</th><th>Статус</th><th>Мастер</th><th></th></tr>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.Id</td>
                <td>@o.CreationDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@o.Client.FullName</td>
                <td>@o.PhoneModel.GetFullName()</td>
                <td>@string.Join(", ", o.Faults.Select(f => f.Title))</td>
                <td>@o.Status.ToDisplayName()</td>
                <td>@(o.Master?.FullName ?? "—")</td>
                <td><a asp-action="Details" asp-route-id="@o.Id">Открыть</a></td>
            </tr>
        }
    </table>
}
